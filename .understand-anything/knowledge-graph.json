  "tour": [
    {
      "order": 1,
      "title": "Pipeline Orchestration",
      "description": "Start at src/pipeline/run.py, the central command hub of the FPL assistant. This script orchestrates the four key phases of the weekly pipeline: data collection, prediction, optimization, and post-gameweek updates using a clean CLI interface.",
      "nodeIds": [
        "file:src/pipeline/run.py"
      ],
      "languageLesson": "Python's argparse module is used here to create a robust CLI, allowing users to trigger specific phases of the research pipeline like 'predict' or 'retrain'."
    },
    {
      "order": 2,
      "title": "Infrastructure & Automation",
      "description": "The scripts/weekly_run.sh bash script provides a unified wrapper for the Python pipeline. It demonstrates how the research project is operationalized for regular, scheduled execution, including logging and environment setup.",
      "nodeIds": [
        "file:scripts/weekly_run.sh"
      ],
      "languageLesson": "Bash scripting is used here to provide a simple, high-level interface for complex Python execution, a common pattern in data engineering for automation."
    },
    {
      "order": 3,
      "title": "Data Collection & API Integration",
      "description": "The foundation begins with data collection. collector.py manages the high-level gathering of weekly statistics, while fetch.py handles the technical details of communicating with the official FPL API and normalizing results into a consistent format.",
      "nodeIds": [
        "file:src/data_collection/collector.py",
        "file:src/pipeline/fetch.py"
      ]
    },
    {
      "order": 4,
      "title": "Feature Engineering & Data Prep",
      "description": "Transforming raw data into predictive signals happens in this stage. prepare.py merges historical datasets with live data, while features.py implements the core logic for calculating rolling averages and form-based metrics that drive the machine learning models.",
      "nodeIds": [
        "file:src/pipeline/prepare.py",
        "file:src/pipeline/features.py"
      ]
    },
    {
      "order": 5,
      "title": "Point Prediction Engine",
      "description": "The machine learning core lives in predict.py. This module loads trained Random Forest or XGBoost models to generate expected points (xP) for the next gameweek, serving as the critical input for the subsequent optimization phase.",
      "nodeIds": [
        "file:src/pipeline/predict.py"
      ],
      "languageLesson": "The pipeline uses scikit-learn compatible models (Random Forest, XGBoost). Notice how model files (.sav) are loaded during the inference phase to generate real-time predictions."
    },
    {
      "order": 6,
      "title": "Squad Optimization",
      "description": "Selecting the winning team under budget constraints involves sophisticated mathematical optimization. This project showcases an evolution from R-based integer linear programming in FPL.R to a modern Python-based approach using the PuLP library in optimize.py.",
      "nodeIds": [
        "file:src/optimization/FPL.R",
        "file:src/pipeline/optimize.py"
      ],
      "languageLesson": "R's lpSolve and Python's PuLP provide different ways to express the same FPL constraints (e.g., maximum 3 players per team) as an Integer Linear Programming problem."
    },
    {
      "order": 7,
      "title": "Quality Assurance & Testing",
      "description": "To ensure research reliability, the testing infrastructure provides comprehensive coverage. test_run.py validates individual pipeline phases, while test_integration.py ensures the end-to-end flow from data fetch to team selection is correct.",
      "nodeIds": [
        "file:tests/test_run.py",
        "file:tests/test_integration.py"
      ]
    }
  ]
